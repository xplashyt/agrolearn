# Llave pública de Wompi. Define el ambiente: pub_test_ apunta a sandbox, pub_prod_ a producción.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Llave privada. Solo se usa en rutas de API, nunca llega al navegador.
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de integridad: firma cada transacción antes de crearla.
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx

# Secreto de eventos: verifica la firma del webhook. Sin esto el webhook rechaza todo con 401.
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx

# API key de Resend. Si falta, el webhook responde 500 y Wompi reintenta el aviso.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# A dónde te llega el aviso de cada venta.
ORDER_NOTIFY_EMAIL=ventas@tudominio.com

# Remitente del aviso. Opcional: por defecto usa onboarding@resend.dev.
ORDER_FROM_EMAIL=agrolearn@tudominio.com
